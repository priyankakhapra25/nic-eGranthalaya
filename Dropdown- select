[BindProperty]
public List<StateModel>? StateList { get; set; } = new List<StateModel>();

public void OnGet()
{
    LoadStates();
}

 private void LoadStates()
 {
     NpgsqlConnection conn = null;
     NpgsqlTransaction tx = null;
     StateList = new List<StateModel>();

     try
     {
         string connectionString = ConnectionString.CNamedash;
         conn = new NpgsqlConnection(connectionString);
         conn.Open();
         tx = conn.BeginTransaction();

         string cursorName = "cur_state";

         using (var cmd = new NpgsqlCommand("sp_manage_pi_request", conn, tx))
         {
             cmd.CommandType = CommandType.StoredProcedure;

             // Required parameters
             cmd.Parameters.AddWithValue("action_type", "load_state");

             var resultMessage = new NpgsqlParameter("result_message", NpgsqlDbType.Text)
             {
                 Direction = ParameterDirection.InputOutput,
                 Value = ""
             };
             cmd.Parameters.Add(resultMessage);

             var refCursor = new NpgsqlParameter("ref", NpgsqlDbType.Refcursor)
             {
                 Direction = ParameterDirection.InputOutput,
                 Value = cursorName
             };
             cmd.Parameters.Add(refCursor);

             // All remaining  input parameters as NULL
             cmd.Parameters.AddWithValue("p_pi_id", DBNull.Value);

             cmd.ExecuteNonQuery();
         }

         // 🔥 Fetch from cursor
         using (var fetchCmd = new NpgsqlCommand($"FETCH ALL IN \"{cursorName}\";", conn, tx))
         using (var reader = fetchCmd.ExecuteReader())
         {
             while (reader.Read())
             {
                 StateList.Add(new StateModel
                 {
                     stcode = reader["state_code"]?.ToString(),
                     statename = reader["state_name"]?.ToString()
                 });
             }
         }

         tx.Commit();
     }
     catch (Exception ex)
     {
         Console.WriteLine("⚠️ Error in LoadStates: " + ex.Message);
         try { tx?.Rollback(); } catch (Exception rollEx) { Console.WriteLine("Rollback failed: " + rollEx.Message); }
     }
     finally
     {
         if (conn?.State == ConnectionState.Open)
             conn.Close();
         conn?.Dispose();
     }
 }

--------------post method---------------
public async Task<IActionResult> OnPost()
{
    if (!ModelState.IsValid)
    {
        return Page();
    }
    string connectionString = ConnectionString.CNamedash;
    var con = new NpgsqlConnection(connectionString);
    await con.OpenAsync();

    try
    {
        // file upload -- sign pi req
        var pi = piReq.PiNo.Replace("/", "_");
        var uploadsFolder = Path.Combine(Directory.GetCurrentDirectory(), "wwwroot", "uploads");
        if (!Directory.Exists(uploadsFolder))
            Directory.CreateDirectory(uploadsFolder);


        var SignPIRequest = pi + "_" + Path.GetFileName(piReq.SignPIRequest.FileName);
        var SignPIRequestPath = Path.Combine(uploadsFolder, SignPIRequest);

        await using (var stream = new FileStream(SignPIRequestPath, FileMode.Create))
        {
            await piReq.SignPIRequest.CopyToAsync(stream);
        }

---------------- file upload------------
        var UploadPIFile = pi + "_" + Path.GetFileName(piReq.UploadPIFile.FileName);
        var UploadPIFilePath = Path.Combine(uploadsFolder, UploadPIFile);

        await using (var stream = new FileStream(UploadPIFilePath, FileMode.Create))
        {
            await piReq.UploadPIFile.CopyToAsync(stream);
        }

        using (var cmd = new NpgsqlCommand("usp_update_pi_info", con))
        {
            cmd.CommandType = CommandType.StoredProcedure;

            cmd.Parameters.AddWithValue("action_type", "insert_pi");
            cmd.Parameters.AddWithValue("org_st_code", piReq.OrganisationState ?? (object)DBNull.Value);
            cmd.Parameters.AddWithValue("pi_file", UploadPIFile ?? (object)DBNull.Value);
           
            var refCursorParam = new NpgsqlParameter("ref", NpgsqlTypes.NpgsqlDbType.Refcursor)
            {
                Direction = ParameterDirection.InputOutput,
                Value = DBNull.Value
            };
            cmd.Parameters.Add(refCursorParam);

            var resultMsgParam = new NpgsqlParameter("result_message", NpgsqlTypes.NpgsqlDbType.Text)
            {
                Direction = ParameterDirection.Output
            };
            cmd.Parameters.Add(resultMsgParam);

            await cmd.ExecuteNonQueryAsync();

            piReq.resultMsg = cmd.Parameters["result_message"].Value?.ToString();
            TempData["Message"] = piReq.resultMsg;
        }
    }
    catch (Exception ex)
    {
        TempData["Message"] = piReq.resultMsg;
    }
    await con.CloseAsync();
    LoadStates();
    return Page();
}
