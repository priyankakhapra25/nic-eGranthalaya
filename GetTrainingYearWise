//------------------------------------------------------------asmx page---------------------------------------------

  [WebMethod]
  [ScriptMethod(ResponseFormat = ResponseFormat.Json)]

  public  List<YearWiseTraining> GetTrainingYearWise()
  {
      List<YearWiseTraining> result = new List<YearWiseTraining>();
      DataSet DtSet = new DataSet();

      try
      {
           mobjclsDB = new clsDatabase();

          string SQL = @"
      SELECT EXTRACT(YEAR FROM DATE_FROM)::int AS Year,
             COUNT(*) AS TrainingCount
      FROM TABLENAME
      WHERE DATE_FROM IS NOT NULL
      GROUP BY EXTRACT(YEAR FROM DATE_FROM)
      ORDER BY Year ASC;";

          NpgsqlCommand Cmd = new NpgsqlCommand(SQL);
          DtSet = mobjclsDB.GetDataset(Cmd);

          if (DtSet != null && DtSet.Tables.Count > 0)
          {
              foreach (DataRow dr in DtSet.Tables[0].Rows)
              {
                  result.Add(new YearWiseTraining
                  {
                      Year = Convert.ToInt32(dr["Year"]),
                      TrainingCount = Convert.ToInt32(dr["TrainingCount"])
                  });
              }
          }
      }
      catch (Exception ex)
      {
          // Debugging ke liye
          throw new Exception("GetTrainingYearWise error: " + ex.Message, ex);
      }
      finally
      {
          DtSet.Dispose();
      }

      return result;
  }

//------------------------------------------------------------aspx page---------------------------------------------

<div id="YearlyChart" style="overflow-x:auto;">
</div>


<script>
    $(document).ready(function () {
        $.ajax({
            url: '/webService.asmx/GetTrainingYearWise',
            type: 'POST',
            contentType: "application/json; charset=utf-8",
            dataType: 'json',
            data: '{}',
            success: function (response) {
                var data = response.d;

                var chartData = data.map(function (item) {
                    return [item.Year.toString(), item.TrainingCount];
                });

                
                $('#YearlyChart').jqChart({
                    title: { text: 'Year Wise Training Records' },
                    animation: { duration: 2 },
                    shadows: { enabled: true },
                    legend: { visible: false },
                    background: '#E0F7FA',
                    border: { strokeStyle: '#666666' },
                    axes: [
                        {
                            type: 'category',
                            location: 'bottom',
                            interval: 1 // show all years
                        },
                        {
                            location: 'left',
                            minimum: 0
                        }
                    ],
                    series: [
                        {
                            type: 'column',
                            fillStyles: ['#418CF0', '#FCB441', '#E0400A', '#056492', '#BFBFBF', '#1A3B69', '#FFE382'],
                            labels: { font: '12px sans-serif' },
                            data: chartData
                        }
                    ]
                });

                // Tooltip formatting
                $('#YearlyChart').bind('tooltipFormat', function (e, d) {
                    return '<b>' + d.dataItem[0] + ' (' + parseFloat(d.dataItem[1]) + ')</b>';
                });
            },
            error: function (xhr, status, error) {
                console.error("Error loading chart: ", error);
                console.error("Response Text: ", xhr.responseText);
            }
        });
    });
</script>

